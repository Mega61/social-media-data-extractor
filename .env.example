# ---- Telegram ----------------------------------------------------------
# From @BotFather. Looks like 8012345678:AAH....
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id, from @userinfobot. Comma-separate for more.
# The bot ignores every message from anyone not in this list.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Gemini ------------------------------------------------------------
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Profiles (niches) -------------------------------------------------
# Each config/profiles/*.yml is one niche: its own tag vocabulary, prompt and
# note shape. A cheap router pass picks one per reel; sending a reel with a
# hashtag naming a profile (#dev) forces it instead.
# Set AUTO_ROUTE=false to skip the router and always use DEFAULT_PROFILE.
DEFAULT_PROFILE=marketing
AUTO_ROUTE=true

# ---- Rate limiting (start conservative, raise after 2 weeks clean) -----
DOWNLOAD_MIN_INTERVAL_S=90
DOWNLOAD_DAILY_CAP=20

# ---- Retention ---------------------------------------------------------
MEDIA_RETENTION_DAYS=30

# ---- Vault location ----------------------------------------------------
# The vault is a plain folder on the homelab so the markdown is readable
# directly (Obsidian, file manager, SMB). Notes land in
# $VAULT_DIR/reels/<profile>/ — one folder per profile in config/profiles/.
VAULT_DIR=/srv/reel-vault
# Your host user, so the notes are yours and not root-owned.
# Get them with:  id -u   and   id -g
VAULT_UID=1000
VAULT_GID=1000

# ---- Samba share (only with docker-compose.samba.yml) ------------------
SMB_USER=reel
SMB_PASSWORD=

# ---- Vault git ---------------------------------------------------------
# Leave GIT_REMOTE empty to commit locally without pushing (M2 default).
GIT_REMOTE=
GIT_BRANCH=main
GIT_AUTHOR_NAME=reel-bot
GIT_AUTHOR_EMAIL=reel-bot@localhost
